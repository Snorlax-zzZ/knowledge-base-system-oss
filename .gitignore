# VERSION 走 git 追踪 (v1.3.13 决策)
# 保证 dev / build / installer 三处版本号一致。
# 每次 bump 需同步四处: VERSION + build_direct_install.ps1 -Version + installer.iss AppVersion
# + build_mac_direct_install_dmg.sh VERSION; test_release_contract.py 兜底断言。

# Windows app 旧构建产物
windows-app/build/
windows-app/dist/
windows-app/*.spec

# macOS app 构建产物
mac-app/*.app/
mac-app/.DS_Store

# 临时
tmp/
.tmp/
